# Base URL of the FastAPI backend (no trailing slash).
# Local dev: omit this file/var entirely -- the app falls back to http://localhost:8000.
# Production: set VITE_API_URL as a Vercel Project Environment Variable, not in a
# committed .env file. Vite bakes this value in at build time, so changing it in
# Vercel requires a redeploy to take effect.
VITE_API_URL=https://your-subdomain.duckdns.org
