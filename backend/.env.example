# Comma-separated list of origins allowed to call this API (CORS).
# Local dev default (used automatically if this var is unset) is:
#   http://localhost:5173,http://127.0.0.1:5173
#
# In production, set this to your deployed frontend origin(s), e.g.:
ALLOWED_ORIGINS=https://your-app.vercel.app

# This file is a template only. On the VM, this variable is set via the
# systemd unit's `Environment=` line (see backend/deploy/realestate-backend.service),
# not via a .env loader -- the app reads it with plain os.environ.get().
